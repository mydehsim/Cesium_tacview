{
    "cmake.sourceDirectory": "C:/Users/sena/Documents/Qt_Projects/Qt_Cesium_Tacview/Cesium_Tacview",
    "cmake.buildDirectory": "${workspaceFolder}/build-qt",
    "cmake.configureOnOpen": true,
    "cmake.useCMakePresets": "always",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "files.associations": {
        "*.h": "cpp",
        "*.qrc": "xml"
    },
    "editor.formatOnSave": true,
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "files.exclude": {
        "**/build-qt/CMakeFiles": true,
        "**/build-qt/Cesium_Tacview_autogen": true,
        "**/build-Cesium_Tacview-*": true,
        "**/build/CMakeFiles": true
    },
    "search.exclude": {
        "**/build-qt": true,
        "**/build-Cesium_Tacview-*": true,
        "**/build": true,
        "**/node_modules": true
    }
}